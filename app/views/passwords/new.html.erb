<% content_for :title, t("auth.forgot_title") %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1><%= t("auth.forgot_title") %></h1>

    <%= form_with url: passwords_path, class: "auth-form" do |form| %>
      <label class="input--actor">
        <%= form.email_field :email_address, class: "input", required: true, autofocus: true,
              autocomplete: "username", placeholder: t("auth.email_placeholder"),
              value: params[:email_address] %>
        <%= icon_tag "email" %>
      </label>
      <%= form.submit t("auth.reset_submit"), class: "btn btn--reversed" %>
    <% end %>

    <p class="auth-alt">
      <%= link_to t("auth.sign_in_submit"), new_session_path %>
    </p>
  </div>
</div>
